    <select id="showMyAppStatus" resultMap="selectResultMap">
        select distinct
            a.employee_name,        -- 이름
            b.approval_state,       -- 결재 상태 (0, 1, 2, 9)
        case
            when c.leave_type = 1 then '반차'
            when c.leave_type = 2 then '연차'
            when c.leave_type = 0 then '연장근무'
            end as category,        -- 구분 (leave_type 기준, 0이면 연장근무)
            f.department_name,      -- 부서명
            d.position,             -- 직책
            e.schedule_start_date,  -- 신청 일시
            b.approval_completion_time -- 결재 일시
        from employee a
            join approval b on (a.employee_no = b.employee_no)
            join dayoff c on (a.employee_no = c.employee_no)
            join human_resource d on (a.employee_no = d.employee_no)
            join schedule e on (a.employee_no = e.employee_no)
            join department f on (a.department_no = f.department_no)
    </select>

    <resultMap id="vacationStatusMapper" type="com.semi.lynk.function.human.model.calendar.VacationApplicationDTO">
        <id property="id" column="employee_no"/>
        <result property="name" column="employee_name"/>
        <result property="totalLeave" column="totalLeave"/>
        <result property="usedLeave" column="usedLeave"/>
        <result property="leaveType" column="leave_type"/>
        <result property="scheduleStartDate" column="schedule_start_date"/>
        <result property="scheduleEndDate" column="schedule_end_date"/>
        <result property="leaveStartDate" column="leave_start_date"/>
        <result property="leaveEndDate" column="leave_end_date"/>
    </resultMap>

    <!-- 휴가 신청 누를 때 데이터 가져와서 보여주는 애 -->
    <select id="vacationAppMapper" resultMap="vacationStatusMapper">
    select distinct
         a.employee_no
        ,a.employee_name
        ,c.totalLeave
        ,c.usedLeave
<!--        ,d.leave_type-->
<!--        ,d.leave_start_date-->
<!--        ,d.leave_end_date-->
<!--        ,e.schedule_start_date-->
<!--        ,e.schedule_end_date-->
    from employee a
        join department b on (a.department_no = b.department_no)
        join human_resource c on (a.employee_no = c.employee_no)
<!--        join dayoff d on (a.employee_no = d.employee_no)-->
<!--        join schedule e on (a.employee_no = e.employee_no)-->
<!--    where-->
<!--        a.employee_no = 12-->
        <!-- 이 사번은 나중에 로그인 연동 할 거-->
    </select>

    <select id="vacAppDayOffCount" resultType="int">
        SELECT COALESCE(MAX(draft_no), 0)
             FROM dayoff
        WHERE employee_no = 12
    </select>

    <update id="vacAppUpdateMapper" parameterType="com.semi.lynk.function.human.model.calendar.VacationApplicationDTO">
        update
            human_resource
        set
            usedLeave = usedLeave + #{usedLeave}
        where
            employee_no = 12;  <!-- 이 사번은 나중에 로그인 연동 할 거-->
<!-- 남은 연차 컬럼은 산술로 가능하니 있을 필요 없음.-->
    </update>

    <insert id="vacAppInsertMapper1" parameterType="com.semi.lynk.function.human.model.calendar.VacationApplicationDTO">
        insert into schedule (employee_no, schedule_start_date,
                            schedule_end_date, schedule_note, schedule_type)
        values (12, #{scheduleStartDate}, #{scheduleEndDate}, #{scheduleNote}, #{leaveType})
    </insert>

    <insert id="vacAppInsertMapper2" parameterType="com.semi.lynk.function.human.model.calendar.VacationApplicationDTO">
        INSERT INTO dayoff
                (employee_no, leave_start_date, leave_end_date, leave_type, draft_no)
        VALUES
                (12, #{leaveStartDate}, #{leaveEndDate}, #{leaveType}, #{draftNo})
    </insert>

    <resultMap id="overTimeAppResultMap" type="com.semi.lynk.function.human.model.calendar.OverTimeApplicationDTO">
        <id property="id" column="employee_no"/>
        <result property="name" column="employee_name"/>
        <result property="scheduleStartDate" column="schedule_start_date"/>
        <result property="scheduleEndDate" column="schedule_end_date"/>
        <result property="scheduleType" column="schedule_type"/>
        <result property="scheduleNote" column="schedule_note"/>
        <result property="workOff" column="work_off"/>
    </resultMap>

    <select id="overTimeAppMapper" resultMap="overTimeAppResultMap">
        select distinct
             employee_name <!-- 결재자 : 사번 , 이름 나중에 연결 / option에 들어갈 애들 -->
        from
            employee
<!--        where-->
<!--            employee_no = 12 &lt;!&ndash; 신청 올리는 애 : 나중에 연결&ndash;&gt;-->
    </select>

    <update id="overTimeAppDataMapper" parameterType="com.semi.lynk.function.human.model.calendar.OverTimeApplicationDTO">
        update schedule <!-- 난중에 고쳐야 함 -->
             set
             schedule_start_date = #{scheduleStartDate}
            ,schedule_end_date = #{scheduleEndDate}
            ,schedule_note = #{scheduleNote} -- 'overtime'
        where
            employee_no = 12; <!-- 나중에 신청 보내는 애(로그인)랑 연결할 거 -->
    </update>
</mapper>